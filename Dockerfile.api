# Docker-outside-of-Docker: this image only needs the docker CLI client
# (plus the compose plugin, used by the update-trigger's sibling-container
# invocation of scripts/update.sh) to talk to the host daemon over a
# mounted socket, not a full Docker install.
FROM docker:27-cli AS docker-cli

FROM node:20-slim

# git: needed for git-source builds and scripts/update.sh's git pull.
# ca-certificates: HTTPS git clones/npm installs, and the update-checker's
# call to the GitHub API. curl: scripts/update.sh's health-check poll.
# python3/make/g++: needed to build better-sqlite3's native module.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git ca-certificates curl python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose \
     /usr/local/libexec/docker/cli-plugins/docker-compose

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY scripts ./scripts

ENV NODE_ENV=production

# No EXPOSE — the app binds to $PORT directly (set via .env), and the
# actual host<->container port mapping lives in docker-compose.yml.

CMD ["node", "src/api/server.mjs"]
