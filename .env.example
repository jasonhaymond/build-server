# Port the API listens on. Bind to localhost/LAN only — the public-facing
# hostname is terminated by a separate Caddy reverse proxy, not this process.
PORT=8080

# Fully-qualified base URL used to build permanent artifact download links.
# Must match the public hostname behind the reverse proxy in production.
# Trailing slash is stripped automatically if present.
PUBLIC_BASE_URL=http://localhost:8080

# Docker image tag used for isolated Android build containers, built from
# Dockerfile. Named per-platform (build-server-<platform>) since other
# platforms may get their own image alongside this one later.
ANDROID_BUILD_IMAGE=build-server-android:latest

# 32-byte key (64 hex characters) used to encrypt build secrets at rest
# while a build is queued, so a genuinely-queued build survives an API
# restart without ever storing secrets in plaintext. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start without a validly-formatted key.
JOB_SECRETS_ENCRYPTION_KEY=

# Maximum wall-clock time (ms) a single build is allowed to run before it's
# killed and marked failed. Default is 2 hours.
BUILD_TIMEOUT_MS=7200000

# Git sources must be HTTPS and must not resolve to a private/internal
# address (SSRF protection) unless this is set to true. Only enable this
# for trusted/internal deployments — it also allows local filesystem paths
# as Git sources (used for testing against a local checkout).
ALLOW_LOCAL_GIT_SOURCES=false

# How many days a completed/failed/cancelled build's on-disk artifacts and
# logs are kept before scripts/cleanup.mjs removes them (the builds table
# row itself is kept for history). Not run automatically — wire it up to
# a cron job if you want scheduled cleanup.
RETENTION_DAYS=30

# Rotation threshold (bytes) for the API's own operational log file
# (logs/api.log) — one backup kept (logs/api.log.1) past this size.
LOG_MAX_SIZE_BYTES=10485760

# --- Docker Compose deployment only (see docker-compose.yml) ---
# The docker-compose stack runs the API in a container that talks to the
# HOST's Docker daemon over a mounted socket (Docker-outside-of-Docker) so
# it can launch isolated Android build containers. See docs/deployment.md
# for the tradeoff this implies.

# Absolute HOST path to this deployment directory (the directory containing
# docker-compose.yml). Required so the worker can tell the host daemon
# where to bind-mount a build's files from — the API container's own
# internal path (/app/builds/...) means nothing to the daemon.
HOST_PROJECT_DIR=/home/youruser/build-server

# UID:GID the isolated Android build container runs as. Not meaningful to
# derive from the API container's own user (which may be root) once the
# API itself is containerized — pin it explicitly instead.
BUILD_CONTAINER_UID=1000
BUILD_CONTAINER_GID=1000

# The host's docker group GID, so the API container's user can access the
# mounted docker.sock without running as root. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=

# Comma-separated list of origins allowed to call this API cross-origin
# (needed if the web UI in web/ is served from its own hostname/Caddy site
# rather than the same origin as this API). Empty means no cross-origin
# access at all — never set this to a wildcard.
WEB_UI_ORIGIN=https://builds.example.com

# "owner/repo" — used by GET /api/v1/system to check GitHub's tags for a
# newer version than what's currently running (public API, no auth
# needed). Leave unset to skip the check; it degrades gracefully either
# way (network failures never break the endpoint).
GITHUB_REPO=jasonhaymond/build-server

# API_IMAGE is NOT set here — docker-compose.yml sets it directly on the
# api service (must match its own `image:` value), since it's an
# implementation detail of the Compose deployment, not something to
# reconfigure per-install. It's what the web UI's "Update now" button
# uses to spawn the sibling container that runs scripts/update.sh — see
# docs/deployment.md. Unset (non-Compose deployments) means that button
# refuses with a clear error rather than doing nothing silently.

# DB_PATH is NOT meant to be set here either — it's a test-only override
# (see tests/setup.mjs) that points the database module at a disposable
# temp file instead of data/build-server.db. A real deployment should
# never set it.
